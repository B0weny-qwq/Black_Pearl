   82          // 函数: CheckData
   83          // 描述: 数据校验函数.
   84          // 参数: None.
   85          // 返回: None.
   86          // 版本: V1.0, 2020-09-28
   87          //========================================================================
   88          static u8 CheckData(u8 dat)
   89          {
   90   1        if((dat >= '0') && (dat <= '9'))    return (dat-'0');
   91   1        if((dat >= 'A') && (dat <= 'F'))    return (dat-'A'+10);
   92   1        if((dat >= 'a') && (dat <= 'f'))    return (dat-'a'+10);
   93   1        return 0xff;
   94   1      }
