  603          /**
  604           * @brief   执行 I2C 总线恢复
  605           * @return  none
  606           *
  607           * @details
  608           * 当 SDA 或 SCL 被从机意外拉低时，尝试恢复总线。
  609           * 禁用 I2C 模块，将 P1.4/P1.5 切为 GPIO 开漏，
  610           * 手动发送 9 个时钟脉冲迫使从机释放 SDA，最后发送 STOP。
  611           *
  612           * @note    此函数直接操作引脚，适用于 I2C 总线死锁场景
  613           */
  614          void QMI8658_BusRecover(void)
  615          {
  616   1          LOGD("IMU", "bus recover start");
  617   1      
  618   1          I2C_Function(DISABLE);
  619   1          I2C_Master();
  620   1      
  621   1          P1_MODE_OUT_OD(GPIO_Pin_4 | GPIO_Pin_5);
  622   1          P1_PULL_UP_ENABLE(GPIO_Pin_4 | GPIO_Pin_5);
  623   1      
  624   1          {
  625   2              u8 i;
  626   2              for (i = 0; i < 9; i++) {
  627   3                  P15 = 0;
  628   3                  QMI8658_Delay_ms(1);
  629   3                  P15 = 1;
  630   3                  QMI8658_Delay_ms(1);
  631   3                  if (P14 == 1) break;
  632   3              }
  633   2              P14 = 1;
  634   2              QMI8658_Delay_ms(1);
  635   2          }
  636   1      
  637   1          P1_MODE_OUT_OD(GPIO_Pin_4 | GPIO_Pin_5);
  638   1          I2C_Function(ENABLE);
  639   1          I2C_Master();
  640   1      
  641   1          LOGI("IMU", "bus recover done");
  642   1      }
