  966          /**
  967           * @brief   初始化 QMI8658 IMU
  968           * @return  0=成功，-1=失败
  969           *
  970           * @details
  971           * 完整初始化流程:
  972           *   1. LOG 初始化开始
  973           *   2. 尝试主地址 (0x6B)，失败则尝试备地址 (0x6A)
  974           *   3. 读取 WHO_AM_I 确认芯片 (0x05)
  975           *   4. 检查 RESET_STATE: 0x80=已就绪, 0x00=需软复位
  976           *   5. 软复位 (写入 RESET=0xB0 到地址0x60) → 等待 500ms
  977           *   6. 分阶段写入控制寄存器
  978           *   7. 等待数据就绪 (STATUS0.aDA=1)
  979           *   8. LOG 初始化完成
C251 COMPILER V5.60.0,  QMI8658                                                            12/05/26  17:56:52  PAGE 16  

  980           *
  981           * @note    必须在 I2C_config() 初始化完成后调用
  982           */
  983          s8 QMI8658_Init(void)
  984          {
  985   1          u8 id = 0xFF;
  986   1          u8 reset_state;
  987   1          u8 ctrl1_rb, ctrl2_rb, ctrl3_rb, ctrl5_rb, ctrl7_rb;
  988   1      
  989   1          LOGI("IMU", "========== QMI8658 Init Start ==========");
  990   1          LOGI("IMU", "stable bring-up: soft_reset=%u diag=%u i2c=%s",
  993   1               (u16)QMI8658_SOFT_RESET_ENABLE,
  993   1               (u16)QMI8658_DIAG_ENABLE,
  993   1               QMI8658_I2cPathName());
  994   1          LOGD("IMU", "primary addr=0x%02X alt=0x%02X",
  996   1               QMI8658_I2C_WRITE(QMI8658_I2C_ADDR_PRIMARY),
  996   1               QMI8658_I2C_WRITE(QMI8658_I2C_ADDR_ALT));
  997   1      
  998   1          /*---------------------------- 地址探测 ----------------------------*/
  999   1          /*---------------------------- 上电等待 ----------------------------*/
 1000   1          LOGD("IMU", "power-up wait %ums", QMI8658_PWR_UP_DELAY_MS);
 1001   1          QMI8658_Delay_ms(QMI8658_PWR_UP_DELAY_MS);
 1002   1      
 1003   1          /*---------------------------- WHO_AM_I 检测 ------------------------*/
 1004   1          if (QMI8658_SelectAddrByWhoAmI(&id) != 0) {
 1005   2              LOGE("IMU", "WHO_AM_I error got=0x%02X exp=0x%02X", id, QMI8658_CHIP_ID_VALUE);
 1006   2              return -1;
 1007   2          }
 1008   1          LOGD("IMU", "WHO_AM_I=0x%02X OK addr=0x%02X", id, QMI8658_I2C_Addr);
 1009   1      
 1010   1          /*---------------------------- RESET_STATE 检测 ------------------------*/
 1011   1          reset_state = QMI8658_ReadReg(QMI8658_REG_RESET_STATE);
 1012   1          LOGI("IMU", "reset_state before=0x%02X", reset_state);
 1013   1      
 1014   1      #if QMI8658_SOFT_RESET_ENABLE
                   if (reset_state != QMI8658_RESET_STATE_READY) {
                       if (QMI8658_WriteReg(QMI8658_REG_RESET, 0xB0) != 0) {
                           LOGE("IMU", "soft reset WR fail");
                           return -1;
                       }
               
                       QMI8658_Delay_ms(QMI8658_RESET_DELAY_MS);
                       reset_state = QMI8658_ReadReg(QMI8658_REG_RESET_STATE);
                       LOGI("IMU", "reset_state after=0x%02X", reset_state);
                   } else {
                       LOGI("IMU", "reset_state ready, skip reset");
                   }
               #else
 1028   1          LOGI("IMU", "soft reset disabled state=0x%02X", reset_state);
 1029   1      #endif
 1030   1      
 1031   1          if (reset_state == 0xFF) {
 1032   2              LOGE("IMU", "reset_state read fail after reset");
 1033   2              return -1;
 1034   2          }
 1035   1      
 1036   1          id = QMI8658_ReadID();
 1037   1          if (id != QMI8658_CHIP_ID_VALUE) {
 1038   2              LOGE("IMU", "WHO_AM_I lost after reset got=0x%02X", id);
 1039   2              return -1;
 1040   2          }
 1041   1      
 1042   1      #if QMI8658_CLEAR_DATAPATH_ENABLE
                   if (QMI8658_ClearDataPath() != 0) {
                       LOGE("IMU", "clear data path fail");
                       return -1;
