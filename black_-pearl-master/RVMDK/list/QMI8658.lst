                   }
                   QMI8658_LogDataPath("after_clear");
               #else
 1049   1          LOGI("IMU", "skip ctrl6/8/fifo/ctrl9 clear");
 1050   1      #endif
 1051   1      
 1052   1          /*---------------------------- 配置写入 --------------------------*/
