  576          static u8 QMI8658_ProbeAddr(u8 addr)
  577          {
  578   1          qmi8658_last_i2c_error = QMI8658_I2C_OK;
  579   1      
  580   1          if (QMI8658_EnsureBusIdle() != 0) {
  581   2              return 1;
  582   2          }
  583   1      
C251 COMPILER V5.60.0,  QMI8658                                                            12/05/26  17:56:52  PAGE 10  

  584   1          Start();
  585   1          SendData(QMI8658_I2C_WRITE(addr));
  586   1          if (QMI8658_RecvAck()) {
  587   2              Stop();
  588   2              qmi8658_last_i2c_error = QMI8658_I2C_ERR_DEVW_NACK;
  589   2              return 1;
  590   2          }
  591   1          Stop();
  592   1      
  593   1          if (Get_MSBusy_Status()) {
  594   2              return 1;  /* NACK: 无设备 */
  595   2          }
  596   1          return 0;  /* ACK: 有设备 */
  597   1      }
