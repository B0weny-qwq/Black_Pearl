 1077   1          if (QMI8658_WriteReg(QMI8658_REG_CTRL3, QMI8658_CTRL3_INIT) != 0) {
 1078   2              LOGE("IMU", "step4 WR fail");
 1079   2              return -1;
 1080   2          }
 1081   1      
 1082   1          /* Step 5: 写入 CTRL5 */
 1083   1          LOGD("IMU", "step5 CTRL5=0x%02X", QMI8658_CTRL5_INIT);
 1084   1          if (QMI8658_WriteReg(QMI8658_REG_CTRL5, QMI8658_CTRL5_INIT) != 0) {
 1085   2              LOGE("IMU", "step5 WR fail");
