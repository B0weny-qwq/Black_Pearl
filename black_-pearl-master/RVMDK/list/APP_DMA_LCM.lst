  448          /*****************************************************************************
  449           * @name       :void LCD_ShowChar(u16 x,u16 y,u16 fc, u16 bc, u8 num,u8 size,u8 mode)
  450           * @date       :2018-08-09 
  451           * @function   :Display a single English character
  452           * @parameters :x:the beginning x coordinate of the Character display position
  453                          y:the beginning y coordinate of the Character display position
  454                          fc:the color value of display character
  455                          bc:the background color of display character
  456                          num:the ascii code of display character(0~94)
  457                          size:the size of display character
  458                          mode:0-no overlying,1-overlying
  459           * @retvalue   :None
  460          ******************************************************************************/ 
  461          void LCD_ShowChar(u16 x,u16 y,u16 fc, u16 bc, u8 num,u8 size,u8 mode)
  462          {
  463   1        u8 temp;
  464   1        u8 pos,t;
  465   1        u16 colortemp=POINT_COLOR;
  466   1      
  467   1        num=num-' ';//得到偏移后的值
  468   1        LCD_SetWindows(x,y,x+size/2-1,y+size-1);//设置单个文字显示窗口
  469   1        if(!mode) //非叠加方式
  470   1        {
  471   2          for(pos=0;pos<size;pos++)
  472   2          {
  473   3            if(size==12)temp=asc2_1206[num][pos];//调用1206字体
  474   3            else temp=asc2_1608[num][pos];     //调用1608字体
  475   3            for(t=0;t<size/2;t++)
  476   3            {
  477   4              if(temp&0x01)LCD_WR_DATA_16Bit(fc); 
  478   4              else LCD_WR_DATA_16Bit(bc); 
  479   4              temp>>=1; 
  480   4            }
  481   3          }
  482   2        }
  483   1        else//叠加方式
  484   1        {
  485   2          for(pos=0;pos<size;pos++)
  486   2          {
  487   3            if(size==12)temp=asc2_1206[num][pos];//调用1206字体
  488   3            else temp=asc2_1608[num][pos];     //调用1608字体
  489   3            for(t=0;t<size/2;t++)
  490   3            {
  491   4              POINT_COLOR=fc;
  492   4              if(temp&0x01) LCD_DrawPoint(x+t,y+pos);//画一个点
  493   4              temp>>=1;
  494   4            }
  495   3          }
  496   2        }
  497   1        POINT_COLOR=colortemp;  
  498   1        LCD_SetWindows(0,0,LCD_W-1,LCD_H-1);//恢复窗口为全屏             
  499   1      }
