  149          
  150          void LCD_Fill(u16 sx,u16 sy,u16 ex,u16 ey,u16 color)
  151          {   
  152   1        u16 i,j;      
  153   1        u16 width=ex-sx+1;    //得到填充的宽度
  154   1        u16 height=ey-sy+1;   //高度
  155   1        LCD_SetWindows(sx,sy,ex,ey);//设置显示窗口
  156   1      
  157   1        for(j=0,i=0;i<=DMA_AMT_LEN;i++)
  158   1        {
  159   2          Color[i] = color;
  160   2        }
  161   1        LCM_Cnt = 75;     //(320 * 240 * 2) / 2048 = 75
  162   1        LCD_CS=0;
  163   1        DMA_LCM_TRIG_WD();  //Write dat
  164   1        while(!LCD_CS);
  165   1      }
  166          
  167          void Test_Color(void)
  168          {
  169   1        LCD_Fill(0,0,lcddev.width,lcddev.height,WHITE);
  170   1        Show_Str(20,30,BLUE,YELLOW,"LCM Test",16,1);delay_ms(800);
  171   1        LCD_Fill(0,0,lcddev.width,lcddev.height,RED);
  172   1        Show_Str(20,30,BLUE,YELLOW,"RED ",16,1);delay_ms(800);
  173   1        LCD_Fill(0,0,lcddev.width,lcddev.height,GREEN);
  174   1        Show_Str(20,30,BLUE,YELLOW,"GREEN ",16,1);delay_ms(800);
  175   1        LCD_Fill(0,0,lcddev.width,lcddev.height,BLUE);
  176   1        Show_Str(20,30,RED,YELLOW,"BLUE ",16,1);delay_ms(800);
  177   1      }
