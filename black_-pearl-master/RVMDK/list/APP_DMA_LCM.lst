  179          /*****************************************************************************
  180           * @name       :void LCD_WR_REG(u8 Reg) 
  181           * @date       :2018-08-09 
  182           * @function   :Write an 16-bit command to the LCD screen
  183           * @parameters :data:Command value to be written
C251 COMPILER V5.60.0,  APP_DMA_LCM                                                        12/05/26  17:56:45  PAGE 4   

  184           * @retvalue   :None
  185          ******************************************************************************/
  186          void LCD_WR_REG(u8 Reg)  
  187          {
  188   1        LCMIFDATL = Reg;
  189   1        LCD_CS=0;
  190   1        LCMIFCR = 0x84;   //Enable interface, write command out
  191   1        while(LcmFlag);
  192   1        LCD_CS = 1 ;
  193   1      } 
  194          
  195          /*****************************************************************************
  196           * @name       :void LCD_WR_DATA(u8 Data)
  197           * @date       :2018-08-09 
  198           * @function   :Write an 16-bit data to the LCD screen
  199           * @parameters :data:data value to be written
  200           * @retvalue   :None
  201          ******************************************************************************/
  202          void LCD_WR_DATA(u8 Data)
  203          {
  204   1        LCMIFDATL = Data;
  205   1        LCD_CS=0;
  206   1        LCMIFCR = 0x85;   //Enable interface, write data out
  207   1        while(LcmFlag);
  208   1        LCD_CS = 1 ;
  209   1      }
  210          
  211          /*****************************************************************************
  212           * @name       :void LCD_WR_DATA_16Bit(u16 Data)
  213           * @date       :2018-08-09 
  214           * @function   :Write an 16-bit command to the LCD screen
  215           * @parameters :Data:Data to be written
  216           * @retvalue   :None
  217          ******************************************************************************/  
  218          void LCD_WR_DATA_16Bit(u16 Data)
  219          {
  220   1        LCD_WR_DATA((u8)(Data>>8));
  221   1        LCD_WR_DATA((u8)Data);
  222   1      }
  223          
  224          /*****************************************************************************
  225           * @name       :void LCD_WriteReg(u8 LCD_Reg, u8 LCD_RegValue)
