  108          void DMA_LCM_init(void)
  109          {
  110   1        LCM_InitTypeDef   LCM_InitStructure;    //结构定义
  111   1        DMA_LCM_InitTypeDef   DMA_LCM_InitStructure;    //结构定义
  112   1      
  113   1        //----------------------------------------------
  114   1        P6_MODE_OUT_PP(GPIO_Pin_All);   //P6 设置成推挽输出
  115   1        P3_MODE_OUT_PP(GPIO_Pin_4);     //P3.4口设置成推挽输出
  116   1        P4_MODE_OUT_PP(GPIO_Pin_2 | GPIO_Pin_3 | GPIO_Pin_4 | GPIO_Pin_5);  //P4.2~P4.5 设置成推挽输出
  117   1        
  118   1        //----------------------------------------------
  119   1        LCM_InitStructure.LCM_Enable = ENABLE;      //LCM接口使能   ENABLE,DISABLE
  120   1        LCM_InitStructure.LCM_Mode = MODE_I8080;    //LCM接口模式   MODE_I8080,MODE_M6800
C251 COMPILER V5.60.0,  APP_DMA_LCM                                                        12/05/26  17:56:45  PAGE 3   

  121   1        LCM_InitStructure.LCM_Bit_Wide = BIT_WIDE_8;  //LCM数据宽度   BIT_WIDE_8,BIT_WIDE_16
  122   1        LCM_InitStructure.LCM_Setup_Time = 2;     //LCM通信数据建立时间   0~7
  123   1        LCM_InitStructure.LCM_Hold_Time = 1;      //LCM通信数据保持时间   0~3
  124   1        LCM_Inilize(&LCM_InitStructure);    //初始化
  125   1        NVIC_LCM_Init(ENABLE,Priority_0);   //中断使能, ENABLE/DISABLE; 优先级(低到高) Priority_0,Prior
             -ity_1,Priority_2,Priority_3
  126   1      
  127   1        //----------------------------------------------
  128   1        DMA_LCM_InitStructure.DMA_Enable = ENABLE;      //DMA使能   ENABLE,DISABLE
  129   1        DMA_LCM_InitStructure.DMA_Length = DMA_AMT_LEN;     //DMA传输总字节数   (0~65535) + 1, 不要超�
             -�芯片 xdata 空间上限
  130   1        DMA_LCM_InitStructure.DMA_Tx_Buffer = (u16)Color; //发送数据存储地址
  131   1        DMA_LCM_InitStructure.DMA_Rx_Buffer = (u16)Buffer;  //接收数据存储地址
  132   1        DMA_LCM_Inilize(&DMA_LCM_InitStructure);    //初始化
  133   1        NVIC_DMA_LCM_Init(ENABLE,Priority_0,Priority_0);  //中断使能, ENABLE/DISABLE; 优先级(低到高) Pr
