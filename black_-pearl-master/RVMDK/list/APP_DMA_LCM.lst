  431          void LCD_SetWindows(u16 xStar, u16 yStar,u16 xEnd,u16 yEnd)
  432          { 
  433   1        LCD_WR_REG(lcddev.setxcmd); 
  434   1        LCD_WR_DATA((u8)(xStar>>8));
  435   1        LCD_WR_DATA(0x00FF&xStar);    
  436   1        LCD_WR_DATA((u8)(xEnd>>8));
  437   1        LCD_WR_DATA(0x00FF&xEnd);
  438   1      
  439   1        LCD_WR_REG(lcddev.setycmd); 
  440   1        LCD_WR_DATA((u8)(yStar>>8));
  441   1        LCD_WR_DATA(0x00FF&yStar);    
  442   1        LCD_WR_DATA((u8)(yEnd>>8));
  443   1        LCD_WR_DATA(0x00FF&yEnd); 
  444   1      
  445   1        LCD_WriteRAM_Prepare(); //开始写入GRAM        
  446   1      }
