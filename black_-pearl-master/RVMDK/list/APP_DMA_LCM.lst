  281          /*****************************************************************************
  282           * @name       :void LCD_direction(u8 direction)
  283           * @date       :2018-08-09 
  284           * @function   :Setting the display direction of LCD screen
  285           * @parameters :direction:0-0 degree
  286                                    1-90 degree
  287                                    2-180 degree
  288                                    3-270 degree
  289           * @retvalue   :None
  290          ******************************************************************************/ 
  291          void LCD_direction(u8 direction)
  292          { 
  293   1          lcddev.setxcmd=0x2A;
  294   1          lcddev.setycmd=0x2B;
  295   1          lcddev.wramcmd=0x2C;
  296   1          lcddev.rramcmd=0x2E;
  297   1        switch(direction){
  298   2          case 0:
  299   2            lcddev.width=LCD_W;
  300   2            lcddev.height=LCD_H;
  301   2            LCD_WriteReg(0x36,(1<<3));
  302   2          break;
  303   2          case 1:
  304   2            lcddev.width=LCD_H;
  305   2            lcddev.height=LCD_W;
  306   2            LCD_WriteReg(0x36,(1<<3)|(1<<7)|(1<<5)|(1<<4));
  307   2          break;
  308   2          case 2:
  309   2            lcddev.width=LCD_W;
  310   2            lcddev.height=LCD_H;  
  311   2            LCD_WriteReg(0x36,(1<<3)|(1<<4)|(1<<6)|(1<<7));
  312   2          break;
  313   2          case 3:
  314   2            lcddev.width=LCD_H;
  315   2            lcddev.height=LCD_W;
C251 COMPILER V5.60.0,  APP_DMA_LCM                                                        12/05/26  17:56:45  PAGE 6   

  316   2            LCD_WriteReg(0x36,(1<<3)|(1<<5)|(1<<6));
  317   2          break;  
  318   2          default:break;
  319   2        }
  320   1      }
