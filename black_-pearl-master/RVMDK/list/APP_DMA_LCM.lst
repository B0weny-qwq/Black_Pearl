  501          /*****************************************************************************
  502           * @name       :void Show_Str(u16 x, u16 y, u16 fc, u16 bc, u8 *str,u8 size,u8 mode)
  503           * @date       :2018-08-09 
  504           * @function   :Display Chinese and English strings
  505           * @parameters :x:the beginning x coordinate of the Chinese and English strings
  506                          y:the beginning y coordinate of the Chinese and English strings
  507                          fc:the color value of Chinese and English strings
  508                          bc:the background color of Chinese and English strings
  509                          str:the start address of the Chinese and English strings
  510                          size:the size of Chinese and English strings
  511                          mode:0-no overlying,1-overlying
  512           * @retvalue   :None
  513          ******************************************************************************/          
C251 COMPILER V5.60.0,  APP_DMA_LCM                                                        12/05/26  17:56:45  PAGE 9   

  514          void Show_Str(u16 x, u16 y, u16 fc, u16 bc, u8 *str,u8 size,u8 mode)
  515          {         
  516   1        u16 x0=x;                   
  517   1        u8 bHz=0;     //字符或者中文 
  518   1        while(*str!=0)//数据未结束
  519   1        { 
  520   2          if(!bHz)
  521   2          {
  522   3            if(x>(LCD_W-size/2)||y>(LCD_H-size)) 
  523   3            return;
  524   3            if(*str>0x80) bHz=1;//中文 
  525   3            else              //字符
  526   3            {
  527   4              if(*str==0x0D)//换行符号
  528   4              {
  529   5                y+=size;
  530   5                x=x0;
  531   5                str++;
  532   5              }
  533   4              else
  534   4              {
  535   5                if(size>16)//字库中没有集成12X24 16X32的英文字体,用8X16代替
  536   5                {  
  537   6                  LCD_ShowChar(x,y,fc,bc,*str,16,mode);
  538   6                  x+=8; //字符,为全字的一半 
  539   6                }
  540   5                else
  541   5                {
  542   6                  LCD_ShowChar(x,y,fc,bc,*str,size,mode);
  543   6                  x+=size/2; //字符,为全字的一半 
  544   6                }
  545   5              }
  546   4              str++;
  547   4            }
  548   3          }
  549   2          else//中文
  550   2          {
  551   3      //      if(x>(lcddev.width-size)||y>(lcddev.height-size))
  552   3      //      return;
  553   3      //      bHz=0;//有汉字库
  554   3      //      if(size==32)
  555   3      //      GUI_DrawFont32(x,y,fc,bc,str,mode);
  556   3      //      else if(size==24)
  557   3      //      GUI_DrawFont24(x,y,fc,bc,str,mode);
  558   3      //      else
  559   3      //      GUI_DrawFont16(x,y,fc,bc,str,mode);
  560   3      
  561   3            str+=2;
  562   3            x+=size;//下一个汉字偏移
  563   3          }
  564   2        }
  565   1      }
