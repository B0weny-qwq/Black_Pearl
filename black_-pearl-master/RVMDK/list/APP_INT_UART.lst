  123   1        delay_ms(1);  //delay 1ms
  124   1        
  125   1        if(WakeUpSource == 1) PrintString2("外中断INT0唤醒  ");
  126   1        if(WakeUpSource == 2) PrintString2("外中断INT1唤醒  ");
  127   1        if(WakeUpSource == 3) PrintString2("外中断INT2唤醒  ");
  128   1        if(WakeUpSource == 4) PrintString2("外中断INT3唤醒  ");
  129   1        if(WakeUpSource == 5) PrintString2("外中断INT4唤醒  ");
  130   1        
  131   1        WakeUpCnt++;
