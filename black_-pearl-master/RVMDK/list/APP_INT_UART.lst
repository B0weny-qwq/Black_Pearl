   58          void INTtoUART_init(void)
   59          {
   60   1        EXTI_InitTypeDef  Exti_InitStructure;         //结构定义
   61   1        COMx_InitDefine   COMx_InitStructure;         //结构定义
   62   1      
   63   1        P3_MODE_IO_PU(GPIO_Pin_All);    //P3.0~P3.7 设置为准双向口
   64   1        P4_MODE_IO_PU(GPIO_Pin_6 | GPIO_Pin_7); //P4.6,P4.7 设置为准双向口
   65   1        P3_PULL_UP_ENABLE(GPIO_Pin_All);//P3 口内部上拉电阻使能
   66   1      
   67   1        COMx_InitStructure.UART_Mode      = UART_8bit_BRTx;   //模式,   UART_ShiftRight,UART_8bit_BRTx,UART_9bi
             -t,UART_9bit_BRTx
   68   1        COMx_InitStructure.UART_BRT_Use   = BRT_Timer2;     //选择波特率发生器, BRT_Timer2 (注意: 串口
             -2固定使用BRT_Timer2)
   69   1        COMx_InitStructure.UART_BaudRate  = 115200ul;     //波特率,     110 ~ 115200
   70   1        COMx_InitStructure.UART_RxEnable  = ENABLE;       //接收允许,   ENABLE或DISABLE
   71   1        UART_Configuration(UART2, &COMx_InitStructure);   //初始化串口 UART1,UART2,UART3,UART4
   72   1        NVIC_UART2_Init(ENABLE,Priority_1);   //中断使能, ENABLE/DISABLE; 优先级(低到高) Priority_0,Pri
             -ority_1,Priority_2,Priority_3
   73   1        //------------------------------------------------
   74   1        Exti_InitStructure.EXTI_Mode      = EXT_MODE_Fall;//中断模式,   EXT_MODE_RiseFall,EXT_MODE_Fall
   75   1        Ext_Inilize(EXT_INT0,&Exti_InitStructure);        //初始化
   76   1        NVIC_INT0_Init(ENABLE,Priority_0);    //中断使能, ENABLE/DISABLE; 优先级(低到高) Priority_0,Prio
