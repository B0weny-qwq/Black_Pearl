   39          void  GPIO_config(void)
   40          {
   41   1        P0_MODE_IO_PU(GPIO_Pin_All);    //P0 设置为准双向口
   42   1        P1_MODE_IN_HIZ(GPIO_Pin_LOW);   //P1.0~P1.3 设置为高阻输入
   43   1        P1_MODE_OUT_OD(GPIO_Pin_4 | GPIO_Pin_5);    //P1.4,P1.5 设置为漏极开路
   44   1        P2_MODE_IO_PU(GPIO_Pin_All);    //P2 设置为准双向口
   45   1        P3_MODE_IO_PU(GPIO_Pin_LOW);    //P3.0~P3.3 设置为准双向口
   46   1        P3_MODE_IO_PU(GPIO_Pin_HIGH);   //P3.4~P3.7 设置为准双向口
   47   1      //  P3_MODE_IN_HIZ(GPIO_Pin_6 | GPIO_Pin_7);    //P3.6,P3.7 设置为高阻输入
   48   1        P4_MODE_IO_PU(GPIO_Pin_0 | GPIO_Pin_6 | GPIO_Pin_7);  //P4.0,P4.6,P4.7 设置为准双向口
   49   1        P6_MODE_IO_PU(GPIO_Pin_All);    //P6 设置为准双向口
   50   1        P7_MODE_IO_PU(GPIO_Pin_All);    //P7 设置为准双向口
   51   1        
   52   1        P1_PULL_UP_ENABLE(GPIO_Pin_4 | GPIO_Pin_5); //P1.4,P1.5 开启内部上拉
   53   1      }
