  164          static void Sensor_I2C_prepare(void)
  165          {
  166   1        /* APP_config() reconfigures P1 pins; restore the shared sensor I2C bus here. */
  167   1        P1_MODE_OUT_OD(GPIO_Pin_4 | GPIO_Pin_5);
  168   1        P1_PULL_UP_ENABLE(GPIO_Pin_4 | GPIO_Pin_5);
  169   1        I2C_SW(I2C_P14_P15);
  170   1        I2C_config();
  171   1      }
  172          
  173          static void QMI8658_PowerOnSelfTest(void)
  174          {
  175   1        u8 id;
  176   1        u8 init_try;
  177   1        u8 retry;
  178   1        int16 ax, ay, az;
  179   1        g_qmi8658_ready = 0;
  180   1      
  181   1        for (init_try = 0; init_try < QMI8658_BOOT_RETRY_COUNT; init_try++) {
  182   2          Sensor_I2C_prepare();
  183   2          QMI8658_BusRecover();
  184   2          delay_ms(100);
  185   2      
  186   2          if (QMI8658_Init() == 0) {
  187   3            break;
  188   3          }
  189   2      
  190   2          LOGE("IMU", "init retry %u/%u mag_id=0x%02X",
  193   2               (u16)(init_try + 1),
  193   2               (u16)QMI8658_BOOT_RETRY_COUNT,
  193   2               QMC6309_ReadID());
  194   2          delay_ms(QMI8658_BOOT_RETRY_DELAY_MS);
  195   2        }
  196   1      
  197   1        if (init_try >= QMI8658_BOOT_RETRY_COUNT) {
  198   2          LOGE("IMU", "boot check fail: init");
  199   2          return;
  200   2        }
  201   1      
  202   1        id = QMI8658_ReadID();
  203   1        if (id != QMI8658_CHIP_ID_VALUE) {
  204   2          LOGE("IMU", "boot check fail: id=0x%02X addr=0x%02X",
  205   2               id, QMI8658_I2C_Addr);
  206   2          return;
  207   2        }
  208   1        LOGI("IMU", "WHO_AM_I=0x%02X i2c_addr=0x%02X", id, QMI8658_I2C_Addr);
  209   1      
  210   1        for (retry = 0; retry < 20; retry++) {
  211   2          if (QMI8658_ReadAcc(&ax, &ay, &az) == 0) {
  212   3            g_qmi8658_ready = 1;
  213   3            LOGI("IMU", "ready addr=0x%02X id=0x%02X acc=%d %d %d",
  214   3                 QMI8658_I2C_Addr, id, ax, ay, az);
  215   3            return;
  216   3          }
  217   2          delay_ms(10);
  218   2        }
  219   1      
  220   1        LOGE("IMU", "boot check fail: readacc i2c_addr=0x%02X data_reg=0x35",
  221   1             QMI8658_I2C_Addr);
  222   1        QMI8658_DumpRawRegs();
  223   1      }
