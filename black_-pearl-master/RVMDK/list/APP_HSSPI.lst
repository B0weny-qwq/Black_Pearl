  456   1      
  457   1          SPI_CE_Low();                       //enable device
  458   1          SPI_WriteByte(SFC_READ);            //read command
  459   1      
  460   1          SPI_WriteByte(((u8 *)&addr)[1]);    //设置起始地址
  461   1          SPI_WriteByte(((u8 *)&addr)[2]);
  462   1          SPI_WriteByte(((u8 *)&addr)[3]);
  463   1      
  464   1          do{
  465   2              *buffer = SPI_ReadByte();       //receive byte and store at buffer
  466   2              buffer++;
  467   2          }while(--size);                     //read until no_bytes is reached
  468   1          SPI_CE_High();                      //disable device
  469   1      }
