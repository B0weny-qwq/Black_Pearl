  488   1          {
  489   2              if(*buffer != SPI_ReadByte())       //receive byte and store at buffer
  490   2              {
  491   3                  j = 1;
  492   3                  break;
  493   3              }
  494   2              buffer++;
  495   2          }while(--size);         //read until no_bytes is reached
  496   1          SPI_CE_High();          //disable device
