  206          /**************** ASCII码转BIN ****************************/
  207          u8  CheckData(u8 dat)
  208          {
  209   1          if((dat >= '0') && (dat <= '9'))        return (dat-'0');
  210   1          if((dat >= 'A') && (dat <= 'F'))        return (dat-'A'+10);
  211   1          return 0xff;
  212   1      }
  213          
  214          /**************** 获取写入地址 ****************************/
  215          u32 GetAddress(void)
  216          {
  217   1          u32 address;
  218   1          u8  i,j;
  219   1          
  220   1          address = 0;
  221   1          if((RX2_Buffer[2] == '0') && (RX2_Buffer[3] == 'X'))
  222   1          {
  223   2              for(i=4; i<10; i++)
  224   2              {
  225   3                  j = CheckData(RX2_Buffer[i]);
  226   3                  if(j >= 0x10)   return 0x80000000;  //error
  227   3                  address = (address << 4) + j;
  228   3              }
  229   2              return (address);
  230   2          }
  231   1          return  0x80000000; //error
  232   1      }
  233          
  234          /**************** 获取要读出数据的字节数 ****************************/
  235          u8  GetDataLength(void)
  236          {
  237   1          u8  i;
  238   1          u8  length;
  239   1          
  240   1          length = 0;
  241   1          for(i=11; i<COM2.RX_Cnt; i++)
  242   1          {
  243   2              if(CheckData(RX2_Buffer[i]) >= 10)  break;
  244   2              length = length * 10 + CheckData(RX2_Buffer[i]);
  245   2          }
