              int8_t qmc5883p_set_output_data_rate(unsigned char rate){
                      
                      int8_t err = 0;
                      unsigned char ctrl1_value = 0;
                      
                      err = qmc5883p_read_block(QMC5883P_CTL_REG_ONE, &ctrl1_value, 1);
                      ctrl1_value = (ctrl1_value& (~0xE8)) | (rate << 5);
                      printf("QMC5883P_set_output_data_rate, 0x0A = [%02x]->[%02x] \r\n", QMC5883P_CTL_REG_ONE,ctrl1_value);
                      err = qmc5883p_write_reg(QMC5883P_CTL_REG_ONE, ctrl1_value);
              
                      return err;     
              }
              #endif
              
              
              int8_t qmc5883p_enable(void)
              {
                      //uint8_t ret = 0;
              
                      qmc5883p_write_reg(0x0a, 0x00);
                      qmc5883p_delay(1);
                      qmc5883p_write_reg(0x0d, 0x40);
                      qmc5883p_write_reg(0x29, 0x06);
                      //qmc5883p_write_reg(0x0a, 0x0F);//0XA9=ODR =100HZ 0XA5 = 50HZ
                      qmc5883p_write_reg(0x0b, 0x00); //      RNG=00 30G   SET/RESET ON
                      qmc5883p_write_reg(0x0a, 0xcf);                 //c3   Continuous Mode 11  ODR=200HZ
                      qmc5883p_delay(1);
                      
                      return 1;
              }
              
              
              
              int8_t qmc5883p_init(void)
              {
                      int8_t ret = 0;
                      
                      mag_addr = QMC5883P_IIC_ADDR;
                      ret = qmc5883p_get_chipid();
                      if(ret == 1)
                      {
                              ret = qmc5883p_write_reg(0x0b, 0x80);
                              qmc5883p_delay(5);                              
                              ret = qmc5883p_write_reg(0x0b, 0x00);
                              qmc5883p_delay(5);
                      }
              
                      qmc5883p_set_layout(0);
                      qmc5883p_enable();
                      {
                              unsigned char ctrl_value;
                              qmc5883p_read_block(QMC5883P_CTL_REG_ONE, &ctrl_value, 1);
                              printf("MAG  ctrl1=0x%bx \r\n",  ctrl_value);
              
                              if (ctrl_value == 0xcf)
                              {       
C51 COMPILER V9.52.0.0   QMC5883P                                                          04/17/2026 09:18:02 PAGE 6   

                                      s_mag_init_ok = 1;
                              }
                              qmc5883p_read_block(QMC5883P_CTL_REG_TWO, &ctrl_value, 1);
                              printf("MAG  ctrl2=0x%bx \r\n",  ctrl_value);
                              qmc5883p_read_block(0x0d, &ctrl_value, 1);
                              printf("MAG  ctrl3=0x%bx \r\n", ctrl_value);
                      }
                      return 1;
              }
              
              
