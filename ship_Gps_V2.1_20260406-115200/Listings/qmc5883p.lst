              int8_t qmc5883p_get_chipid(void)
              {
                      int8_t ret = 0;
                      int i;  
                unsigned char chipid = 0x00;
              
                      //mag_addr = 0;
                      
                      for(i = 0; i<2; i++)
                      {
                              ret = qmc5883p_read_block(QMC5883P_CHIP_ID_REG, &chipid, 1);
                              if(chipid == 0x80)
                              {       
                                      //ret = qmc5883p_write_reg(0x0a, 0x00); // suspend mode
                                      //printf("MAG read chip id OK slave:0x%bx id:0x%bx\r\n", mag_addr, chipid);
                                      printf("MAG read chip id OK! \r\n");
                                      return 1;
                              }
                              //mag_addr ++;
                      }
              
                      printf("MAG read chip id fail\r\n");
              
                      return 0;
              }
              
              
