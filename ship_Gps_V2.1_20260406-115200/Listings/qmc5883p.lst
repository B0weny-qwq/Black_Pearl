              typedef struct{
                      signed char sign[3];
                      unsigned char map[3];
              } QMC5883P_map;
              
              
              uint8_t idata chipid = 0;
              uint8_t idata mag_addr = QMC5883P_IIC_ADDR;
              
              QMC5883P_map idata c_map;
              extern bit s_mag_init_ok;
              
              
              int8_t qmc5883p_read_block(uint8_t addr, uint8_t *data_m, uint8_t len)
              {
                  SI2C_ReadNbyte(QMC5883P_IIC_ADDR,addr,data_m,len);
                  return 1;
              }
              
              int8_t qmc5883p_write_reg(uint8_t addr, uint8_t data_m)
              {   
                  SI2C_WriteNbyte(QMC5883P_IIC_ADDR,addr,(uint8_t *)&data_m,1);
                  return 1;
              }
              
              
              void qmc5883p_delay(uint8_t ms_cnt)
C51 COMPILER V9.52.0.0   QMC5883P                                                          04/17/2026 09:18:02 PAGE 2   

              {
                      //extern void qst_delay_ms(unsigned int n_ms);
              
                      SysTimer_delayms(ms_cnt + 1);
              }
              
              
              static void qmc5883p_set_layout(int layout)
              {
                      if(layout == 0)
                      {
                              c_map.sign[AXIS_X] = 1;
                              c_map.sign[AXIS_Y] = 1;
                              c_map.sign[AXIS_Z] = 1;
                              c_map.map[AXIS_X] = AXIS_X;
                              c_map.map[AXIS_Y] = AXIS_Y;
                              c_map.map[AXIS_Z] = AXIS_Z;
                      }
                      else if(layout == 1)
                      {
                              c_map.sign[AXIS_X] = -1;
                              c_map.sign[AXIS_Y] = 1;
                              c_map.sign[AXIS_Z] = 1;
                              c_map.map[AXIS_X] = AXIS_Y;
                              c_map.map[AXIS_Y] = AXIS_X;
                              c_map.map[AXIS_Z] = AXIS_Z;
                      }
                      else if(layout == 2)
                      {
                              c_map.sign[AXIS_X] = -1;
                              c_map.sign[AXIS_Y] = -1;
                              c_map.sign[AXIS_Z] = 1;
                              c_map.map[AXIS_X] = AXIS_X;
                              c_map.map[AXIS_Y] = AXIS_Y;
                              c_map.map[AXIS_Z] = AXIS_Z;
                      }
                      else if(layout == 3)
                      {
                              c_map.sign[AXIS_X] = 1;
                              c_map.sign[AXIS_Y] = -1;
                              c_map.sign[AXIS_Z] = 1;
                              c_map.map[AXIS_X] = AXIS_Y;
                              c_map.map[AXIS_Y] = AXIS_X;
                              c_map.map[AXIS_Z] = AXIS_Z;
                      }       
                      else if(layout == 4)
                      {
                              c_map.sign[AXIS_X] = -1;
                              c_map.sign[AXIS_Y] = 1;
                              c_map.sign[AXIS_Z] = -1;
                              c_map.map[AXIS_X] = AXIS_X;
                              c_map.map[AXIS_Y] = AXIS_Y;
                              c_map.map[AXIS_Z] = AXIS_Z;
                      }
                      else if(layout == 5)
                      {
                              c_map.sign[AXIS_X] = 1;
                              c_map.sign[AXIS_Y] = 1;
                              c_map.sign[AXIS_Z] = -1;
                              c_map.map[AXIS_X] = AXIS_Y;
                              c_map.map[AXIS_Y] = AXIS_X;
                              c_map.map[AXIS_Z] = AXIS_Z;
