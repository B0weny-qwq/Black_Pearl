                              c_map.sign[AXIS_Y] = -1;
                              c_map.sign[AXIS_Z] = -1;
                              c_map.map[AXIS_X] = AXIS_Y;
                              c_map.map[AXIS_Y] = AXIS_X;
                              c_map.map[AXIS_Z] = AXIS_Z;
