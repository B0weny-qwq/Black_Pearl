 507          void Wireless_Send(uint8_t FreqChannel,uint8_t cmdID,uint8_t *data_m,uint8_t len,uint8_t role){
 508   1      
 509   1        
 510   1          uint8_t index = 0;
 511   1          wirelessSendData[index++] = 0xaa;
 512   1          wirelessSendData[index++] = 2 + len;
 513   1          wirelessSendData[index++] = cmdID;
 514   1      
 515   1          memcpy(&wirelessSendData[index],data_m,len);
 516   1          index += len;
 517   1      
 518   1          wirelessSendData[index++] = cal_checksum_XOR(&wirelessSendData[1],2 + len);
 519   1          wirelessSendData[index++] = 0xbb;
 520   1      
 521   1          // uprintf_array((uint8_t *)&wirelessSendData,index);
 522   1          LT8920_TxData(FreqChannel,(uint8_t *)&wirelessSendData,index,role);
 523   1      }
