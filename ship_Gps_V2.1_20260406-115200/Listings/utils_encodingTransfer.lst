              uint8_t charsToHex(uint8_t *asc){
                  uint8_t hex=0;
                  if((asc[0]>='0')&&(asc[0]<='9')){
                      hex=asc[0]-0x30;
                  }else if((asc[0]>='a')&&(asc[0]<='f')){
                      hex=asc[0]-'a'+0xa;
                  }else if((asc[0]>='A')&&(asc[0]<='F')){
