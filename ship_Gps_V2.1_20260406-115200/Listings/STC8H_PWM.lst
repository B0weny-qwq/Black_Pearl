  16          // 函数: PWM_Configuration
  17          // 描述: PWM初始化程序.
  18          // 参数: PWMx: 结构参数,请参考PWM.h里的定义.
  19          // 返回: 成功返回 SUCCESS, 错误返回 FAIL.
  20          // 版本: V1.0, 2012-10-22
  21          //========================================================================
  22          u8 PWM_Configuration(u8 PWM, PWMx_InitDefine *PWMx)
  23          {
  24   1              if(PWM == PWM4)
  25   1              {
  26   2                      PWMA_CC4E_Disable();            //关闭输入捕获/比较输出
  27   2                      PWMA_CC4NE_Disable();           //关闭比较输出
  28   2                      PWMA_CC4S_Direction(CCAS_OUTPUT);               //CCnS仅在通道关闭时才是可写的
  29   2                      PWMA_OC4ModeSet(PWMx->PWM_Mode);                //设置输出比较模式
  30   2      
  31   2                      if(PWMx->PWM_EnoSelect & ENO4P)
  32   2                      {
  33   3                              PWMA_CC4E_Enable();                     //开启输入捕获/比较输出
  34   3                              PWMA_ENO |= ENO4P;
  35   3                      }
  36   2                      else
  37   2                      {
  38   3                              PWMA_CC4E_Disable();            //关闭输入捕获/比较输出
  39   3                              PWMA_ENO &= ~ENO4P;
  40   3                      }
  41   2                      if(PWMx->PWM_EnoSelect & ENO4N)
  42   2                      {
  43   3                              PWMA_CC4NE_Enable();            //开启输入捕获/比较输出
  44   3                              PWMA_ENO |= ENO4N;
  45   3                      }
  46   2                      else
  47   2                      {
  48   3                              PWMA_CC4NE_Disable();           //关闭输入捕获/比较输出
  49   3                              PWMA_ENO &= ~ENO4N;
  50   3                      }
  51   2                      
  52   2                      PWMA_Duty4(PWMx->PWM_Duty);
