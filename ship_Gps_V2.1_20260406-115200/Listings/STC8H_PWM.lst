C51 COMPILER V9.52.0.0   STC8H_PWM                                                         04/17/2026 09:17:57 PAGE 3   

 115          void UpdatePwm(u8 PWM, PWMx_Duty *PWMx)
 116          {
 117   1              switch(PWM)
 118   1              {
 119   2                      case PWM4:
 120   2                              PWMA_Duty4(PWMx->PWM1_Duty);
 121   2                      break;
 122   2      
 123   2                      case PWM3:
 124   2                              PWMA_Duty3(PWMx->PWM3_Duty);
 125   2                      break;
 126   2      
 127   2                      case PWMA:
 128   2                              PWMA_Duty4(PWMx->PWM1_Duty);
 129   2                              PWMA_Duty3(PWMx->PWM3_Duty);
 130   2                      break;
 131   2      
 132   2              }
 133   1      }
