 131          void gs_get_tilt(short *XYZangle,short *xyzdata)
 132          { 
 133   1          short gx,gy,gz;
 134   1          short *xAngle,*yAngle,*zAngle;
 135   1          short  yz_plane, xz_plane , xy_plane; 
 136   1          short tanX,tanY,tanZ;
 137   1      
 138   1          xAngle = XYZangle;
 139   1          yAngle = XYZangle+1;
 140   1          zAngle = XYZangle+2;
 141   1          
 142   1          gx = (short)(*xyzdata);
 143   1          gy = (short)(*(xyzdata+1));
 144   1          gz = (short)(*(xyzdata+2));
 145   1        
 146   1          yz_plane = (short)(sqrt((gy)*(gy)+(gz)*(gz)));
 147   1          xz_plane = (short)(sqrt((gx)*(gx)+(gz)*(gz)));
 148   1          xy_plane = (short)(sqrt((gx)*(gx)+(gy)*(gy)));
 149   1      
 150   1          if(yz_plane==0.0)
 151   1          {
 152   2              *xAngle = 90.0;
 153   2          }
 154   1          else
 155   1          {
 156   2              tanX = ((short)(gx))/yz_plane;
 157   2              *xAngle = atan(tanX)*180.0/3.14;
 158   2          }
 159   1          
 160   1             
 161   1          if(xz_plane==0.0)
 162   1          {
 163   2              *yAngle = 90.0; 
 164   2          }
 165   1          else
 166   1          {
 167   2              tanY = ((short)(gy))/xz_plane; 
 168   2              *yAngle = atan(tanY)*180.0/3.14;
 169   2          }
 170   1          
 171   1          if((gz) == 0.0)
 172   1          {
 173   2              *zAngle = 90.0;  
 174   2          }
 175   1          else
 176   1          {
C51 COMPILER V9.60.7.0   GYRO                                                              06/27/2024 18:46:20 PAGE 4   

 177   2              tanZ = xy_plane/((short)(gz));  
 178   2              *zAngle = atan(tanZ)*180.0/3.14; 
 179   2          }  
 180   1      }
