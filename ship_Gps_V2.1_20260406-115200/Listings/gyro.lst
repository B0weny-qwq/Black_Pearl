  71          //Read three axis data, 2g range, counting 12bit, 1G=1000mg=1024lsb
  72          void mir3da_read_raw_data(short *x, short *y, short *z)
  73          {
  74   1      
  75   1          uint8_t tmp_data[6] = {0};
