  78   1          uprintf_array(&tmp_data,6);
  79   1          
  80   1          *x = ((short)(tmp_data[1] << 8 | tmp_data[0]))>> 4;
  81   1          *y = ((short)(tmp_data[3] << 8 | tmp_data[2]))>> 4;
  82   1          *z = ((short)(tmp_data[5] << 8 | tmp_data[4]))>> 4;
  83   1          printf("x==%b04x,y=%b04x,z=%b04x\r\n",*x,*y,*z );
  84   1      }
