  53          // I2C总线函数
  54          //========================================================================
  55          void I2C_Start(void)         //start the I2C, SDA High-to-low when SCL is high
  56          {
  57   1              SDA = 1;
  58   1              I2C_Delay();
  59   1              SCL = 1;
  60   1              I2C_Delay();
  61   1              SDA = 0;
  62   1              I2C_Delay();
  63   1              SCL = 0;
  64   1              I2C_Delay();
  65   1      }       
  66          
  67          
  68          void I2C_Stop(void)           //STOP the I2C, SDA Low-to-high when SCL is high
  69          {
  70   1              SDA = 0;
  71   1              I2C_Delay();
  72   1              SCL = 1;
  73   1              I2C_Delay();
  74   1              SDA = 1;
  75   1              I2C_Delay();
  76   1      }
  77          
  78          void S_ACK(void)              //Send ACK (LOW)
  79          {
  80   1              SDA = 0;
  81   1              I2C_Delay();
  82   1              SCL = 1;
  83   1              I2C_Delay();
  84   1              SCL = 0;
  85   1              I2C_Delay();
  86   1      }
  87          
  88          void S_NoACK(void)           //Send No ACK (High)
  89          {
  90   1              SDA = 1;
  91   1              I2C_Delay();
  92   1              SCL = 1;
  93   1              I2C_Delay();
  94   1              SCL = 0;
  95   1              I2C_Delay();
  96   1      }
  97                  
  98          void I2C_Check_ACK(void)     //Check ACK, If F0=0, then right, if F0=1, then error
  99          {
 100   1              SDA = 1;
 101   1              I2C_Delay();
 102   1              SCL = 1;
 103   1              I2C_Delay();
 104   1              F0  = SDA;
 105   1              SCL = 0;
 106   1              I2C_Delay();
 107   1      }
