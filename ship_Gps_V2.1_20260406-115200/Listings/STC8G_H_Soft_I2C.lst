  45          void I2C_Delay(void) //for normal MCS51, delay (2 * dly + 4) T, for STC12Cxxxx delay (4 * dly + 10) T
  46          {
  47   1              u8  dly;
  48   1              dly = MAIN_Fosc / 800000UL;        //�?us计算
  49   1              while(--dly);
