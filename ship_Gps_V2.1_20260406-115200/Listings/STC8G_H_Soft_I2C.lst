 195          //========================================================================
 196          void SI2C_ReadNbyte(u8 dev_addr, u8 mem_addr, u8 *p, u8 number)  /*  DeviceAddress,WordAddress,First Data 
             -Address,Byte lenth  */
 197          {
 198   1              I2C_Start();
 199   1              I2C_WriteAbyte(dev_addr);
 200   1              I2C_Check_ACK();
 201   1              if(!F0)
 202   1              {
 203   2                      I2C_WriteAbyte(mem_addr);
 204   2                      I2C_Check_ACK();
 205   2                      if(!F0)
 206   2                      {
 207   3                              I2C_Start();
 208   3                              I2C_WriteAbyte(dev_addr|1);
 209   3                              I2C_Check_ACK();
 210   3                              if(!F0)
 211   3                              {
 212   4                                      do
 213   4                                      {
 214   5                                              *p = I2C_ReadAbyte();   p++;
 215   5                                              if(number != 1)     S_ACK();    //send ACK
 216   5                                      }
 217   4                                      while(--number);
 218   4                                      S_NoACK();          //send no ACK
 219   4                              }
 220   3                      }
 221   2              }
 222   1              I2C_Stop();
