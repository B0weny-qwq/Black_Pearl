 115          //========================================================================
 116          void I2C_WriteAbyte(u8 dat)     //write a byte to I2C
 117          {
 118   1              u8 i;
 119   1              i = 8;
 120   1              do
 121   1              {
 122   2                      if(dat & 0x80)  SDA = 1;
 123   2                      else            SDA = 0;
 124   2                      dat <<= 1;
 125   2                      I2C_Delay();
 126   2                      SCL = 1;
 127   2                      I2C_Delay();
 128   2                      SCL = 0;
 129   2                      I2C_Delay();
 130   2              }
 131   1              while(--i);
 132   1      }
 133          
 134          //========================================================================
 135          // 函数: u8 I2C_ReadAbyte(void)
 136          // 描述: I2C读取一个字节数据函�?
 137          // 参数: none.
 138          // 返回: 读取数据.
 139          // 版本: V1.0, 2020-09-15
 140          //========================================================================
 141          u8 I2C_ReadAbyte(void)          //read A byte from I2C
 142          {
 143   1              u8 i,dat;
 144   1              i = 8;
 145   1              SDA = 1;
 146   1              do
 147   1              {
 148   2                      SCL = 1;
 149   2                      I2C_Delay();
 150   2                      dat <<= 1;
 151   2                      if(SDA)     dat++;
 152   2                      SCL  = 0;
 153   2                      I2C_Delay();
 154   2              }
 155   1              while(--i);
 156   1              return(dat);
 157   1      }
