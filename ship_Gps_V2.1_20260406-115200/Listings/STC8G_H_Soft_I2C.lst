 166          void SI2C_WriteNbyte(u8 dev_addr, u8 mem_addr, u8 *p, u8 number)  /*  DeviceAddress,WordAddress,First Data
             - Address,Byte lenth  */
 167          {
 168   1              I2C_Start();
 169   1              I2C_WriteAbyte(dev_addr);
 170   1              I2C_Check_ACK();
 171   1              if(!F0)                                           //F0=0,right, F0=1,error
 172   1              {
 173   2                      I2C_WriteAbyte(mem_addr);
 174   2                      I2C_Check_ACK();
C51 COMPILER V9.52.0.0   STC8G_H_SOFT_I2C                                                  04/17/2026 09:17:57 PAGE 4   

 175   2                      if(!F0)
 176   2                      {
 177   3                              do
 178   3                              {
 179   4                                      I2C_WriteAbyte(*p); p++;
 180   4                                      I2C_Check_ACK();
 181   4                                      if(F0)  break;
 182   4                              }
 183   3                              while(--number);
 184   3                      }
 185   2              }
 186   1              I2C_Stop();
 187   1      }
