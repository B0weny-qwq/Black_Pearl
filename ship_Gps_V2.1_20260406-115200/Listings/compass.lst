  76          float compass_get_angle(void)  
  77          {
  78   1          float angle;
  79   1          int16_t magx, magy;
  80   1              
  81   1          magx = (compassXYZData[0] - g_magx_offset) ;     /* 根据校准参数, 计算新的输出 */
  82   1          magy = (compassXYZData[1] - g_magy_offset) ;     /* 根据校准参数, 计算新的输出 */
  83   1      
  84   1          /* 根据不同的象限情况, 进行方位角换算 */
  85   1          if ((magx > 0) && (magy > 0))
  86   1          {
  87   2              angle = (atan((double)magy / magx) * 57.29578);
  88   2          }
  89   1          else if ((magx > 0) && (magy < 0))
  90   1          {
  91   2              angle = 360 + (atan((double)magy / magx) * 57.29578);
  92   2          }
  93   1          else if ((magx == 0) && (magy > 0))
  94   1          {
  95   2              angle = 90;
  96   2          }
  97   1          else if ((magx == 0) && (magy < 0))
  98   1          {
  99   2              angle = 270;
 100   2          }
 101   1          else if (magx < 0)
 102   1          {
 103   2              angle = 180 + (atan((double)magy / magx) * 57.29578);
 104   2          }
 105   1          
 106   1          if (angle > 360) angle = 360; /* 限定方位角范围 */
 107   1          if (angle < 0) angle = 0;     /* 限定方位角范围 */
 108   1      
 109   1          return (int16_t)(angle*10);
 110   1      }
