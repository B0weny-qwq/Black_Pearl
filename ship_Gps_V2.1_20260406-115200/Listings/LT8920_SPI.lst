 497          void LT8920_TxData(unsigned char FreqChannel,unsigned char *pBuf,unsigned char length,uint8_t role)
 498          {
 499   1          TX_EN_H;
 500   1      //      printf("Fre  autodrive = %bd\r\n",FreqChannel);
 501   1              LT_WriteReg(7,0,FreqChannel,role);      //IDLE
 502   1              LT_WriteReg(52, 0x80, 0x80,role);       //清除指针
 503   1              // LT_WriteReg( 8, 0x6c, 0x90);
 504   1              LT_WriteBUF(50,pBuf,length,role);       //写入fifo
 505   1              
 506   1              LT_WriteReg(7,1,FreqChannel,role); //发射数据
 507   1              
 508   1              delay_us(100);
 509   1              while(LT8920_GetPKT(role) ==0)
 510   1              {
 511   2                      #if (PKT_readReg == 0)
                                      delay_us(100);                          //读取PKT引脚
                              #endif          
 514   2                      #if (PKT_readReg == 1)
 515   2                              delay_us(1000);                         //查�?�寄存器的PKT状�?
 516   2                      #endif                  
 517   2              }
 518   1              
 519   1              LT_WriteReg(7,0,FreqChannel,role);//发完数据,进入IDLE
 520   1      
 521   1        if(role == LT8920_SEND){
 522   2              RXBusy_Send=0;
 523   2        }else{
 524   2              RXBusy_Rec=0;
 525   2        }
 526   1        TX_EN_L;
 527   1      }
