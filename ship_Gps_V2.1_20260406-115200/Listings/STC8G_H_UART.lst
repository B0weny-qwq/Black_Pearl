                                      if(COMx->BaudRateDouble == ENABLE)      AUXR |=  (1<<5);        //固定波特率SysClk/2
                                      else                                                            AUXR &= ~(1<<5);        //固定波特率SysClk/12
                              }
                              else if(COMx->UART_Mode == UART_9bit)   //固定波特率SysClk*2^SMOD/64
