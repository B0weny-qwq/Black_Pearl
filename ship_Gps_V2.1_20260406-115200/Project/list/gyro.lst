  68          //Read three axis data, 2g range, counting 12bit, 1G=1000mg=1024lsb
  69          void mir3da_read_raw_data(short *x, short *y, short *z)
  70          {
  71   1          uint8_t tmp_data[6] = {0};
  72   1         
  73   1        mir3da_register_read(REG_ACC_X_LSB, tmp_data, 6);
  74   1      
  75   1          *x = ((short)(tmp_data[1] << 8 | tmp_data[0]))>> 4;
  76   1          *y = ((short)(tmp_data[3] << 8 | tmp_data[2]))>> 4;
  77   1          *z = ((short)(tmp_data[5] << 8 | tmp_data[4]))>> 4;
  78   1      }
  79          
