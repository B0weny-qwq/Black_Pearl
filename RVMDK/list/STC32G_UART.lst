  231          #ifdef UART1
  232          void TX1_write2buff(u8 dat) //串口1发送函数
  233          {
  234   1          #if(UART_QUEUE_MODE == 1)
  235   1        if((((u8)(COM1.TX_write + 1U) >= (u8)COM_TX1_Lenth) ? 0U : (u8)(COM1.TX_write + 1U)) == COM1.TX_send) re
             -turn;
  236   1        TX1_Buffer[COM1.TX_write] = dat;  //装发送缓冲，使用队列式数据发送，一次性发送数据
             -长度不要超过缓冲区大小（COM_TXn_Lenth）
  237   1        if(++COM1.TX_write >= COM_TX1_Lenth)  COM1.TX_write = 0;
  238   1      
  239   1        if(COM1.B_TX_busy == 0)   //空闲
  240   1        {  
  241   2          COM1.B_TX_busy = 1;   //标志忙
  242   2          TI = 1;         //触发发送中断
  243   2        }
  244   1          #else
                   //以下是阻塞方式发送方法
                 SBUF = dat;
                 COM1.B_TX_busy = 1;   //标志忙
                 while(COM1.B_TX_busy);
                   #endif
  250   1      }
