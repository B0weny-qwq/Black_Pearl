  119          void Sample_LIN(void)
  120          {
  121   1        u8 i;
  122   1      #if(LIN_MASTER_MODE==1)
  123   1        if(!P32)
  124   1        {
  125   2          if(!Key1_Flag)
  126   2          {
  127   3            Key1_cnt++;
  128   3            if(Key1_cnt > 50)
  129   3            {
  130   4              Key1_Flag = 1;
  131   4              LinSendFrame(Lin_ID, TX_BUF);  //发送一串完整数据
  132   4            }
  133   3          }
  134   2        }
  135   1        else
  136   1        {
  137   2          Key1_cnt = 0;
  138   2          Key1_Flag = 0;
  139   2        }
  140   1      
  141   1        if(!P33)
  142   1        {
  143   2          if(!Key2_Flag)
  144   2          {
  145   3            Key2_cnt++;
  146   3            if(Key2_cnt > 50)
  147   3            {
  148   4              Key2_Flag = 1;
  149   4              LinSendHeaderRead(0x13,TX_BUF);  //发送帧头，获取数据帧，组成一个完整的帧
  150   4              printf("接收如下：\r\n");
  151   4              for(i=0; i<FRAME_LEN; i++)    printf("%02x ", TX_BUF[i]);
  152   4              printf("\r\n");
  153   4            }
  154   3          }
  155   2        }
  156   1        else
  157   1        {
  158   2          Key2_cnt = 0;
  159   2          Key2_Flag = 0;
  160   2        }
  161   1      #else
                 u8 isr;
               
                 if(LinRxFlag == 1)
                 {
                   LinRxFlag = 0;
                   isr = LinReadReg(LID);
                   if(isr == 0x12)   //判断是否从机响应ID
                   {
                     LinTxResponse(TX_BUF);  //返回响应数据
                   }
                   else
                   {
                     LinReadFrame(TX_BUF);     //接收Lin总线数据
                     printf("ID=0x%02X, 接收内容：\r\n",isr);
                     for(i=0; i<FRAME_LEN; i++)    printf("%02x ", TX_BUF[i]);
                     printf("\r\n");
                   }
                 }
               #endif
  181   1      }
