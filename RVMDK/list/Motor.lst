   88          static void Motor_LeftSetForwardPolarity(void)
   89          {
   90   1          /* Left motor wiring is fixed on the board:
   91   1           * PWM3N -> MLA -> HIN, PWM3P -> MLB -> LIN#
   92   1           * To get a real complementary pair at the pins, HIN must see the
   93   1           * active-high phase while LIN# sees the active-low phase. */
