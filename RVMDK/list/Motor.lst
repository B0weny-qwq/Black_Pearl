   36   3              }
   37   2          }
   38   1      
   39   1          duty = (int32)(MOTOR_PWM_PERIOD / 2U);
   40   1          duty += ((int32)speed * (int32)(MOTOR_PWM_PERIOD / 2U)) / (int32)MOTOR_SPEED_MAX;
