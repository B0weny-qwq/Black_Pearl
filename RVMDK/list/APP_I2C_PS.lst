   98   1        
   99   1        if(++msecond >= 1000)   //1秒到
  100   1        {
  101   2          msecond = 0;        //清1000ms计数
  102   2          second++;         //秒计数+1
  103   2          if(second >= 200)    second = 0;   //秒计数范围为0~199
  104   2      
  105   2          temp[0] = second / 1000;
  106   2          temp[1] = (second % 1000) / 100;
  107   2          temp[2] = (second % 100) / 10;
  108   2          temp[3] = second % 10;
  109   2          LED8[0] = temp[0];
  110   2          LED8[1] = temp[1];
  111   2          LED8[2] = temp[2];
  112   2          LED8[3] = temp[3];
  113   2      
  114   2          SI2C_WriteNbyte(SLAW, 0, temp, 4);
  115   2        }
