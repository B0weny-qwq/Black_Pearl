   56          void I2C_PS_init(void)
   57          {
   58   1        u8  i;
   59   1        I2C_InitTypeDef   I2C_InitStructure;
   60   1      
   61   1        P0_MODE_IO_PU(GPIO_Pin_0 | GPIO_Pin_1);   //P0.0,P0.1 设置为准双向口
   62   1        P3_MODE_IO_PU(GPIO_Pin_3);      //P3.3 设置为准双向口
   63   1        P6_MODE_IO_PU(GPIO_Pin_All);    //P6 设置为准双向口
   64   1        P7_MODE_IO_PU(GPIO_Pin_All);    //P7 设置为准双向口
   65   1        I2C_SW(I2C_P33_P32);          //I2C_P14_P15,I2C_P24_P25,I2C_P76_P77,I2C_P33_P32
   66   1      
   67   1        I2C_InitStructure.I2C_Mode      = I2C_Mode_Slave;   //主从选择   I2C_Mode_Master, I2C_Mode_Slave
   68   1        I2C_InitStructure.I2C_Enable    = ENABLE;           //I2C功能使能,   ENABLE, DISABLE
   69   1        I2C_InitStructure.I2C_SL_MA     = ENABLE;           //使能从机地址比较功能,   ENABLE, DISABLE
   70   1        I2C_InitStructure.I2C_SL_ADR    = 0x2d;             //从机设备地址,  0~127  (0x2d<<1 = 0x5a)
   71   1        I2C_Init(&I2C_InitStructure);
   72   1        NVIC_I2C_Init(I2C_Mode_Slave,I2C_ESTAI|I2C_ERXI|I2C_ETXI|I2C_ESTOI,Priority_0); //主从模式, I2C_Mode
             -_Master, I2C_Mode_Slave; 中断使能, I2C_ESTAI/I2C_ERXI/I2C_ETXI/I2C_ESTOI/DISABLE; 优先级(低到高) Priority_0,Pr
             -iority_1,Priority_2,Priority_3
   73   1      
   74   1        display_index = 0;
   75   1        DisplayFlag = 0;
   76   1        for(i=0; i<8; i++)  LED8[i] = 0x10; //上电消隐
   77   1      }
