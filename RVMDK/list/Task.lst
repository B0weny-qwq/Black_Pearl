  123          //========================================================================
  124          // 函数: Task_Pro_Handler_Callback
  125          // 描述: 任务处理回调函数.
  126          // 参数: None.
  127          // 返回: None.
  128          // 版本: V1.0, 2012-10-22
  129          //========================================================================
  130          void Task_Pro_Handler_Callback(void)
  131          {
  132   1        u8 i;
  133   1        for(i=0; i<Tasks_Max; i++)
  134   1        {
  135   2          if(Task_Comps[i].Run) /* If task can be run */
  136   2          {
  137   3            Task_Comps[i].Run = 0;    /* Flag clear 0 */
  138   3            Task_Comps[i].TaskHook();  /* Run task */
  139   3          }
  140   2        }
  141   1      }
