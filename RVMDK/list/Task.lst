   65          u8 Tasks_Max = sizeof(Task_Comps)/sizeof(Task_Comps[0]);
   66          static volatile u32 g_task_tick_ms = 0;
   67          
   68          //========================================================================
   69          // 函数: Task_Handler_Callback
   70          // 描述: 任务标记回调函数.
   71          // 参数: None.
   72          // 返回: None.
   73          // 版本: V1.0, 2012-10-22
   74          //========================================================================
   75          /**
   76           * @brief   Timer0 1ms 任务标记回调
   77           * @return  none
   78           *
   79           * @details
   80           * 在 Timer0 ISR 中调用。函数会递增全局毫秒 tick，并递减各任务的软件计数器；
   81           * 当任务计数归零时置 `Run=1`，由主循环中的 `Task_Pro_Handler_Callback()` 执行。
   82           */
   83          void Task_Marks_Handler_Callback(void)
   84          {
   85   1        u8 i;
   86   1        g_task_tick_ms++;
   87   1        for(i=0; i<Tasks_Max; i++)
   88   1        {
   89   2          if(Task_Comps[i].TIMCount)    /* If the time is not 0 */
   90   2          {
   91   3            Task_Comps[i].TIMCount--;  /* Time counter decrement */
   92   3            if(Task_Comps[i].TIMCount == 0)  /* If time arrives */
   93   3            {
   94   4              /*Resume the timer value and try again */
   95   4              Task_Comps[i].TIMCount = Task_Comps[i].TRITime;  
   96   4              Task_Comps[i].Run = 1;    /* The task can be run */
   97   4            }
   98   3          }
   99   2        }
  100   1      }
  101          
  102          /**
  103           * @brief   获取系统毫秒 tick
  104           * @return  系统启动后的毫秒计数，32 位自然回绕
  105           *
  106           * @details
  107           * `g_task_tick_ms` 在 Timer0 中断中更新。读取 32 位变量时短暂关闭总中断，
  108           * 避免 8/16 位 MCU 上多字节读取被中断打断。
  109           */
  110          u32 Task_GetTickMs(void)
  111          {
  112   1        u32 tick;
  113   1        u8 ea_bak;
  114   1      
  115   1        ea_bak = EA;
  116   1        EA = 0;
  117   1        tick = g_task_tick_ms;
  118   1        EA = ea_bak;
  119   1      
  120   1        return tick;
  121   1      }
