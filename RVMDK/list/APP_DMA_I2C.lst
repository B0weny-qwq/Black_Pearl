  275   1        SET_I2C_DMA_ST(number-1);   //设置需要传输字节数：n+1
  276   1        DMA_I2CR_TRIG();
  277   1      
  278   1        while(DmaI2CRFlag);         //DMA忙检测
  279   1        I2C_DMA_Disable();
