  106          //========================================================================
  107          // 函数: I2cCheckData
  108          // 描述: 数据校验函数.
  109          // 参数: None.
  110          // 返回: None.
  111          // 版本: V1.0, 2020-09-28
  112          //========================================================================
  113          static u8 I2cCheckData(u8 dat)
  114          {
  115   1        if((dat >= '0') && (dat <= '9'))    return (dat-'0');
  116   1        if((dat >= 'A') && (dat <= 'F'))    return (dat-'A'+10);
C251 COMPILER V5.60.0,  APP_DMA_I2C                                                        13/05/26  12:22:12  PAGE 3   

  117   1        if((dat >= 'a') && (dat <= 'f'))    return (dat-'a'+10);
  118   1        return 0xff;
  119   1      }
