  200          //========================================================================
  201          void DisplayRTC(void)
  202          {
  203   1          hour = HOUR;
  204   1          minute = MIN;
  205   1      
  206   1          if(HOUR >= 10)  LED8[0] = HOUR / 10;
  207   1          else            LED8[0] = DIS_BLACK;
  208   1          LED8[1] = HOUR % 10;
  209   1          LED8[2] = DIS_;
  210   1          LED8[3] = MIN / 10;
  211   1          LED8[4] = MIN % 10;
  212   1          LED8[5] = DIS_;
  213   1          LED8[6] = SEC / 10;
  214   1          LED8[7] = SEC % 10;
  215   1      }
