  271          //========================================================================
  272          // 函数: IO_KeyScan
  273          // 描述: 按键扫描程序.
  274          // 参数: None.
  275          // 返回: None.
  276          // 版本: V1.0, 2020-09-25
  277          //========================================================================
  278          void IO_KeyScan(void)    //50ms call
  279          {
  280   1          u8  j;
  281   1      
  282   1          j = IO_KeyState1;   //保存上一次状态
  283   1      
  284   1          P0 = 0xf0;  //X低，读Y
  285   1          IO_KeyDelay();
  286   1          IO_KeyState1 = P0 & 0xf0;
  287   1      
  288   1          P0 = 0x0f;  //Y低，读X
  289   1          IO_KeyDelay();
  290   1          IO_KeyState1 |= (P0 & 0x0f);
  291   1          IO_KeyState1 ^= 0xff;   //取反
  292   1          
  293   1          if(j == IO_KeyState1)   //连续两次读相等
  294   1          {
  295   2              j = IO_KeyState;
  296   2              IO_KeyState = IO_KeyState1;
  297   2              if(IO_KeyState != 0)    //有键按下
  298   2              {
  299   3                  F0 = 0;
  300   3                  if(j == 0)  F0 = 1; //第一次按下
  301   3                  else if(j == IO_KeyState)
  302   3                  {
  303   4                      if(++IO_KeyHoldCnt >= 20)   //1秒后重键
  304   4                      {
  305   5                          IO_KeyHoldCnt = 18;
  306   5                          F0 = 1;
  307   5                      }
  308   4                  }
  309   3                  if(F0)
  310   3                  {
  311   4                      j = T_KeyTable[IO_KeyState >> 4];
  312   4                      if((j != 0) && (T_KeyTable[IO_KeyState& 0x0f] != 0)) 
C251 COMPILER V5.60.0,  APP_RTC                                                            13/05/26  12:22:11  PAGE 6   

  313   4                          KeyCode = (j - 1) * 4 + T_KeyTable[IO_KeyState & 0x0f] + 16;    //计算键码，17~3
             -2
  314   4                  }
  315   3              }
  316   2              else    IO_KeyHoldCnt = 0;
  317   2          }
  318   1          P0 = 0xff;
  319   1      }
