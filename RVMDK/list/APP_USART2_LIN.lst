   82   1      #else
                 LIN_InitStructure.LIN_Mode = LinSlaveMode;  //LIN总线模式   LinMasterMode,LinSlaveMode
                 LIN_InitStructure.LIN_AutoSync = ENABLE;    //自动同步使能    ENABLE,DISABLE
               #endif
   86   1        LIN_InitStructure.LIN_Enable   = ENABLE;    //LIN功能使能   ENABLE,DISABLE
   87   1        LIN_InitStructure.LIN_Baudrate = 9600;      //LIN波特率
   88   1        UASRT_LIN_Configuration(USART2,&LIN_InitStructure);           //LIN 初始化
